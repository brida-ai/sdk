{
  "name": "@brida/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Brida platform",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:policy": "node --test scripts/*.policy.mjs",
    "check:public": "bash scripts/public-surface-check.sh",
    "check": "pnpm typecheck && pnpm test && pnpm test:policy && pnpm build && pnpm check:public"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@types/node": "^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brida-ai/sdk.git"
  },
  "homepage": "https://github.com/brida-ai/sdk#readme",
  "bugs": {
    "url": "https://github.com/brida-ai/sdk/issues"
  },
  "keywords": [
    "brida",
    "sdk",
    "api",
    "typescript"
  ]
}
